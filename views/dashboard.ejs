<%- include("layouts/main") %>

<div class="page-header">
  <h1>Dashboard</h1>
  <p class="subtitle">Maintenance overview</p>
</div>

<div class="stats-grid">
  <div class="stat-card">
    <h3>Total Requests</h3>
    <p class="stat-value"><%= total %></p>
  </div>

  <div class="stat-card">
    <h3>Open Requests</h3>
    <p class="stat-value"><%= open %></p>
  </div>

  <div class="stat-card">
    <h3>Completed</h3>
    <p class="stat-value"><%= completed %></p>
  </div>
</div>

<div class="dashboard-section">
  <h2>System Status</h2>

  <% if (total === 0) { %>
    <p class="empty">
      No maintenance activity yet.  
      Once requests are created, insights will appear here.
    </p>
  <% } else { %>
    <ul class="status-list">
      <li>✔ Maintenance tracking active</li>
      <li>✔ Supabase backend connected</li>
      <li>✔ Real-time data ready</li>
    </ul>
  <% } %>
</div>
